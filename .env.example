# ---------------------------------------------------------------------------
# FinSight AI - root environment (read by docker-compose.yml)
# Copy to .env:  Copy-Item .env.example .env
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# PostgreSQL
POSTGRES_USER=finsight
POSTGRES_PASSWORD=finsight
POSTGRES_DB=finsight

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_MINUTES=1440
# Keep lax for same-origin (Vercel /backend rewrite). Use secure=true and
# samesite=none only when the API is on a different site from the frontend.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
# Optional: use Groq embeddings instead of the local Chroma default
GROQ_EMBED_MODEL=

# Object storage (Neon Object Storage in production, MinIO locally)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=finsight-documents
S3_ACCESS_KEY=finsight
S3_SECRET_KEY=finsight-secret
S3_REGION=auto

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
