# Copy to backend/.env for local development (docker-compose injects these too)

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Postgres ---
DATABASE_URL=postgresql+asyncpg://finsight:finsight@localhost:5432/finsight

# --- Auth ---
JWT_SECRET=dev-secret-change-me-0123456789abcdef0123456789abcdef
JWT_EXPIRES_MINUTES=1440
JWT_ALGORITHM=HS256
# Same-origin default. For a cross-site API + frontend, use:
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Groq ---
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_EMBED_MODEL=
GROQ_RERANK_MODEL=

# --- ChromaDB (external HTTP server) ---
# Docker Compose maps host 8001 -> container 8000. For `chroma run --port 9999`,
# use CHROMA_PORT=9999 instead. Collections are created per workspace as
# ws_<workspace_id>; CHROMA_COLLECTION is informational only.
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=finsight_chunks

# --- Object storage ---
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=finsight-documents
S3_ACCESS_KEY=finsight
S3_SECRET_KEY=finsight-secret
S3_REGION=auto

# --- App ---
UPLOAD_DIR=../data/uploads
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=50
